# ====== KONFIGURASI SANITY ======
# Dapatkan nilai ini dari https://www.sanity.io/manage setelah membuat project
NEXT_PUBLIC_SANITY_PROJECT_ID="masukkan_project_id_anda"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Token untuk MENYIMPAN data pendaftaran dari website ke Sanity.
# Buat di: Sanity Manage > API > Tokens > Add API token (pilih izin "Editor").
# WAJIB diisi agar fitur "simpan pendaftaran ke CMS" berjalan.
# JANGAN commit / sebarkan token ini.
SANITY_API_WRITE_TOKEN="masukkan_token_editor_anda"
