# ====== KONFIGURASI SANITY ======
# Dapatkan nilai ini dari https://www.sanity.io/manage setelah membuat project
NEXT_PUBLIC_SANITY_PROJECT_ID="masukkan_project_id_anda"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Token untuk MENYIMPAN data pendaftaran dari website ke Sanity.
# Buat di: Sanity Manage > API > Tokens > Add API token (pilih izin "Editor").
# WAJIB diisi agar fitur "simpan pendaftaran ke CMS" berjalan.
# JANGAN commit / sebarkan token ini.
SANITY_API_WRITE_TOKEN="masukkan_token_editor_anda"

# ====== DATABASE NEON (PostgreSQL) ======
# Buat database gratis di https://neon.tech, lalu salin connection string-nya.
# Panduan lengkap ada di NEON_SETUP.md
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Kunci rahasia untuk menandatangani sesi login (cookie). WAJIB diisi.
# Buat string acak panjang, contoh perintah:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-dan-rahasia"
